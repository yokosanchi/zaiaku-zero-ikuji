---
interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
  /** 記事ページのとき、構造化データ用のメタ */
  article?: {
    datePublished?: string;
    dateModified?: string;
    section?: string;
    tags?: string[];
  };
}

const { title, description, image, ogImage, article } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = '罪悪感ゼロ育児';
const fullTitle = title === siteName ? title : `${title}｜${siteName}`;
const share = ogImage ?? image;
const shareURL = share ? new URL(share, Astro.site).href : undefined;
const origin = Astro.site?.origin ?? 'https://zaiaku-zero-ikuji.pages.dev';

const publisher = {
  '@type': 'Organization',
  name: siteName,
  url: origin,
  logo: { '@type': 'ImageObject', url: `${origin}/favicon.svg` },
};

const jsonLd: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: origin,
    inLanguage: 'ja',
  },
  { '@context': 'https://schema.org', ...publisher },
];

if (article) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'ja',
    mainEntityOfPage: canonicalURL.href,
    ...(shareURL ? { image: shareURL } : {}),
    ...(article.datePublished ? { datePublished: article.datePublished } : {}),
    ...(article.dateModified ? { dateModified: article.dateModified } : {}),
    ...(article.section ? { articleSection: article.section } : {}),
    ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
    author: { '@type': 'Person', name: '管理人', url: `${origin}/about` },
    publisher,
  });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{shareURL && <meta property="og:image" content={shareURL} />}
<meta name="twitter:card" content={shareURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{shareURL && <meta name="twitter:image" content={shareURL} />}

{
  jsonLd.map((obj) => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Yomogi&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Maru+Gothic:wght@500;700&display=swap"
  rel="stylesheet"
/>
