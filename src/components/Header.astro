---
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-30 border-b-2 border-coral-soft bg-cream/95 backdrop-blur">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-3"
  >
    <a href="/" class="group flex items-center gap-2.5">
      <Logo
        class="h-10 w-10 shrink-0 drop-shadow-[3px_3px_0_rgba(63,58,74,0.12)] transition-transform group-hover:-rotate-12"
      />
      <span class="flex flex-col leading-none">
        <span class="font-heading text-lg font-bold text-ink">罪悪感ゼロ育児</span>
        <span class="mt-1 font-hand text-[11px] text-coral-deep">
          あなたはダメな親じゃない。
        </span>
      </span>
    </a>

    <nav class="flex flex-wrap items-center gap-1 text-sm">
      <a
        href="/search"
        aria-label="記事を検索"
        title="記事を検索"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border-2 border-ink/10 bg-white text-base shadow-pop transition-all hover:-translate-y-0.5 hover:bg-sky-soft"
      >
        🔍
      </a>
      <a
        href="/categories"
        class="whitespace-nowrap rounded-full bg-coral px-4 py-1.5 font-bold text-white shadow-pop transition-all hover:-translate-y-0.5 hover:bg-coral-deep"
      >
        記事をさがす
      </a>
      <a
        href="/about"
        class="whitespace-nowrap rounded-full px-3 py-1.5 font-medium text-ink-soft transition-colors hover:bg-sun-soft hover:text-ink"
      >
        このサイトについて
      </a>
      <a
        href="/contact"
        class="whitespace-nowrap rounded-full px-3 py-1.5 font-medium text-ink-soft transition-colors hover:bg-sun-soft hover:text-ink"
      >
        お問い合わせ
      </a>
    </nav>
  </div>
</header>
