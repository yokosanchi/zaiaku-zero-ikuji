---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="『罪悪感ゼロ育児』へのお問い合わせフォームです。記事の内容について、掲載・広告のご相談、その他ご意見・ご感想など、お気軽にご連絡ください。"
>
  <div class="mx-auto max-w-2xl px-5">
    <div class="rounded-[2rem] border-2 border-ink/5 bg-white p-6 shadow-pop-lg sm:p-10">
      <p
        class="inline-flex -rotate-2 items-center gap-1.5 rounded-full border-2 border-ink/5 bg-sun-soft px-4 py-1.5 font-hand text-xs text-coral-deep shadow-pop"
      >
        <span>✉️</span> お気軽にどうぞ
      </p>
      <h1 class="mt-4 font-heading text-2xl font-bold text-ink sm:text-3xl">
        お問い合わせ
      </h1>
      <p class="mt-3 leading-relaxed text-ink-soft">
        記事の内容について、掲載・広告のご相談、その他ご意見・ご感想など。
        <br />
        管理人がひとつずつ目を通しています。お返事までお時間をいただく場合があります。
      </p>

      <form id="contact-form" class="mt-8 space-y-5" novalidate>
        <div>
          <label for="name" class="text-sm font-bold text-ink">お名前（任意）</label>
          <input
            type="text"
            id="name"
            name="name"
            maxlength="100"
            class="mt-1.5 w-full rounded-xl border-2 border-ink/10 bg-cream px-4 py-2.5 text-ink outline-none transition-colors focus:border-coral"
            placeholder="例）田中"
          />
        </div>

        <div>
          <label for="email" class="text-sm font-bold text-ink"
            >返信用メールアドレス <span class="text-coral-deep">必須</span></label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            maxlength="200"
            class="mt-1.5 w-full rounded-xl border-2 border-ink/10 bg-cream px-4 py-2.5 text-ink outline-none transition-colors focus:border-coral"
            placeholder="example@example.com"
          />
        </div>

        <div>
          <label for="category" class="text-sm font-bold text-ink">お問い合わせの種類</label>
          <select
            id="category"
            name="category"
            class="mt-1.5 w-full rounded-xl border-2 border-ink/10 bg-cream px-4 py-2.5 text-ink outline-none transition-colors focus:border-coral"
          >
            <option value="">選択してください（任意）</option>
            <option value="記事の内容について">記事の内容について</option>
            <option value="誤り・修正のご指摘">誤り・修正のご指摘</option>
            <option value="掲載・広告のご相談">掲載・広告のご相談</option>
            <option value="取材・その他のご相談">取材・その他のご相談</option>
            <option value="ご意見・ご感想">ご意見・ご感想</option>
            <option value="その他">その他</option>
          </select>
        </div>

        <div>
          <label for="message" class="text-sm font-bold text-ink"
            >お問い合わせ内容 <span class="text-coral-deep">必須</span></label
          >
          <textarea
            id="message"
            name="message"
            required
            maxlength="3000"
            rows="6"
            class="mt-1.5 w-full rounded-xl border-2 border-ink/10 bg-cream px-4 py-2.5 text-ink outline-none transition-colors focus:border-coral"
            placeholder="内容をご記入ください"></textarea>
        </div>

        <!-- ハニーポット（人間には見えない。ボット対策） -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">ウェブサイト</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="w-full rounded-full bg-coral px-7 py-3 text-sm font-bold text-white shadow-pop transition-all hover:-translate-y-0.5 hover:bg-coral-deep hover:shadow-pop-lg disabled:cursor-not-allowed disabled:opacity-60"
        >
          送信する →
        </button>

        <p id="contact-status" class="hidden rounded-xl px-4 py-3 text-sm font-bold" role="status">
        </p>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const status = document.getElementById('contact-status') as HTMLParagraphElement;
    const startedAt = Date.now();

    function showStatus(kind: 'ok' | 'error', text: string) {
      status.textContent = text;
      status.classList.remove('hidden', 'bg-mint-soft', 'text-ink', 'bg-coral-soft', 'text-coral-deep');
      if (kind === 'ok') {
        status.classList.add('bg-mint-soft', 'text-ink');
      } else {
        status.classList.add('bg-coral-soft', 'text-coral-deep');
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中…';

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        category: data.get('category'),
        message: data.get('message'),
        website: data.get('website'),
        startedAt,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && json.ok) {
          showStatus('ok', '送信しました。お返事まで少しお待ちください🌱');
          form.reset();
        } else if (json.error === 'not-configured') {
          showStatus('error', '現在フォームの受付を準備中です。時間をおいて再度お試しください。');
        } else if (json.error === 'invalid-email') {
          showStatus('error', 'メールアドレスの形式をご確認ください。');
        } else if (json.error === 'empty-message') {
          showStatus('error', 'お問い合わせ内容をご記入ください。');
        } else {
          showStatus('error', '送信に失敗しました。時間をおいて再度お試しください。');
        }
      } catch {
        showStatus('error', '通信エラーが発生しました。時間をおいて再度お試しください。');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送信する →';
      }
    });
  </script>
</BaseLayout>
