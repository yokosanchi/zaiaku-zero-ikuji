# このファイルを `.env` にコピーして値を入れる（.env は git 管理外）。
# ローカルで自動生成を回すとき・手元でテストするときに読み込まれる。

# 必須：Google AI Studio で無料取得 → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 任意：モデル（既定 gemini-3.6-flash）
# GEMINI_MODEL=gemini-3.6-flash

# 任意：記事アイキャッチに Unsplash 写真を使う → https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=

# 任意：improve パスの強さ links(既定) / full
# IMPROVE_MODE=links

# 任意：サムネの惹句を LLM で作る場合 ai
# THUMB_HEADLINE=

# 任意：新着記事を X（Twitter）へ自動投稿する（4つすべて揃うと有効 / App権限は Read and write）
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# 任意：新着記事を Threads へ自動投稿する（2つ揃うと有効）
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
