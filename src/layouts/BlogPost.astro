---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORY_MAP, STAGE_MAP, ARTICLE_TYPES, ACCENT } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  related?: CollectionEntry<'blog'>[];
  toc?: { depth: number; slug: string; text: string }[];
}

const { post, related = [], toc = [] } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  emoji,
  author,
  heroImage,
  ogImage,
  sources,
  snsRefs,
  category,
  stage,
  articleType,
  generatedBy,
} = post.data;

const cat = CATEGORY_MAP[category];
const stg = STAGE_MAP[stage];
const type = ARTICLE_TYPES[articleType];

const dateLabel = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedLabel = updatedDate?.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = new URL(`/blog/${post.slug}`, Astro.site ?? 'https://zaiaku-zero-ikuji.pages.dev').href;
const shareText = `${title}｜罪悪感ゼロ育児`;
const share = {
  x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(postUrl)}`,
  line: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(postUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`,
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  ogImage={ogImage}
>
  <article class="mx-auto max-w-2xl px-5">
    <div class="relative">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center"
      >
        <div
          class:list={[
            'h-56 w-56 rounded-blob animate-floaty',
            ACCENT[cat.accent].softBg,
          ]}
        >
        </div>
      </div>
      {
        heroImage ? (
          <img
            src={heroImage}
            alt=""
            class="mb-6 aspect-[16/9] w-full rotate-1 rounded-[2rem] border-2 border-ink/5 object-cover shadow-pop-lg"
          />
        ) : (
          <div
            class:list={[
              'mb-6 grid aspect-[16/9] w-full place-items-center rounded-[2rem] border-2 border-ink/5 bg-gradient-to-br px-8 text-center shadow-pop-lg',
              ACCENT[cat.accent].grad,
            ]}
          >
            <span class="font-heading text-2xl font-bold leading-snug text-white/95 drop-shadow sm:text-3xl">
              {post.data.title}
            </span>
          </div>
        )
      }
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a
        href={`/categories/${cat.key}`}
        class:list={[
          'rounded-full border-2 border-ink/5 px-3 py-1 text-xs font-bold shadow-pop transition-transform hover:-translate-y-0.5',
          ACCENT[cat.accent].softBg,
          ACCENT[cat.accent].text,
        ]}
      >
        {cat.emoji} {cat.label}
      </a>
      <a
        href={`/stages/${stg.key}`}
        class:list={[
          'rounded-full border-2 border-ink/5 px-3 py-1 text-xs font-bold shadow-pop transition-transform hover:-translate-y-0.5',
          ACCENT[stg.accent].softBg,
          ACCENT[stg.accent].text,
        ]}
      >
        {stg.emoji} {stg.label}
      </a>
      <span
        class="rounded-full border-2 border-ink/5 bg-white px-3 py-1 text-xs font-bold text-ink-soft shadow-pop"
      >
        {type.emoji} {type.label}
      </span>
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <span class="rounded-full bg-cream-deep px-2.5 py-0.5 text-xs font-medium text-ink-soft">
            #{tag}
          </span>
        ))
      }
    </div>

    <h1
      class="mt-4 font-heading text-2xl font-bold leading-tight text-ink sm:text-3xl"
    >
      {title}
    </h1>
    <p class="mt-3 font-hand text-sm text-ink-soft">
      {dateLabel} 公開{updatedLabel && ` ・ ${updatedLabel} 更新`} ・ {author}
    </p>

    {
      toc.length >= 3 && (
        <nav
          aria-label="もくじ"
          class="mt-6 rounded-2xl border-2 border-ink/5 bg-cream-deep/70 p-5 shadow-pop"
        >
          <p class="font-heading text-sm font-bold text-ink">もくじ</p>
          <ol class="mt-2 space-y-1.5 text-sm">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'ml-4' : ''}>
                <a
                  href={`#${h.slug}`}
                  class="text-ink-soft underline decoration-sun decoration-2 underline-offset-2 hover:text-coral-deep"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div
      class="mt-8 rounded-[2rem] border-2 border-ink/5 bg-white p-6 shadow-pop-lg sm:p-9"
    >
      <div
        class="prose max-w-none scroll-mt-24 prose-headings:font-heading prose-headings:scroll-mt-24 prose-headings:font-bold prose-h2:mt-10 prose-h2:inline-block prose-h2:rounded-2xl prose-h2:bg-sun-soft prose-h2:px-4 prose-h2:py-1.5 prose-h2:text-xl prose-h2:leading-snug prose-h2:shadow-pop prose-h3:mt-8 prose-h3:text-lg prose-h3:text-coral-deep prose-a:font-bold prose-a:decoration-sun prose-a:decoration-2 prose-a:underline-offset-2 prose-strong:text-ink prose-blockquote:rounded-2xl prose-blockquote:border-0 prose-blockquote:bg-sky-soft prose-blockquote:p-5 prose-blockquote:font-medium prose-blockquote:not-italic prose-blockquote:text-ink prose-blockquote:shadow-pop prose-li:marker:text-coral"
      >
        <slot />
      </div>
    </div>

    {
      snsRefs.length > 0 && (
        <section class="mt-8 rounded-[1.75rem] border-2 border-ink/5 bg-cream-deep/70 p-5 shadow-pop">
          <p class="flex items-center gap-2 font-heading text-sm font-bold text-ink">
            <span>📱</span> 元になったSNSの話題（参考）
          </p>
          <ul class="mt-2 space-y-1 text-sm text-ink-soft">
            {snsRefs.map((s) => (
              <li>
                <span class="font-bold text-ink-soft">{s.platform}</span>：{' '}
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="font-medium text-sky-deep underline decoration-2 underline-offset-2"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-2 text-xs text-ink-soft/80">
            ※ 話題の傾向を示すためのリンクです。個別の投稿内容は記事内で要約・一般化しており、そのまま引用していません。
          </p>
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section class="mt-8 rounded-[1.75rem] border-2 border-ink/5 bg-sky-soft/60 p-5 shadow-pop">
          <p class="flex items-center gap-2 font-heading text-sm font-bold text-ink">
            <span>📊</span> 根拠にした情報
          </p>
          <ul class="mt-2 space-y-1 text-sm text-ink-soft">
            {sources.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-sky-deep underline decoration-2 underline-offset-2"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <aside
      class="mt-8 -rotate-1 rounded-[2rem] border-2 border-ink/5 bg-coral-soft p-6 shadow-pop sm:p-8"
    >
      <p class="flex items-center gap-2 font-heading text-base font-bold text-ink">
        <span class="text-xl">💛</span> 最後に、あなたへ
      </p>
      <p class="mt-2 text-sm leading-relaxed text-ink/80">
        今日ここまで読んでくれた時点で、あなたはもう十分にお子さんのことを考えています。うまくいかない日があっても全然大丈夫。あなたと赤ちゃんの笑顔が、いちばん大切な「正解」です。
      </p>
    </aside>

    <p class="mt-6 text-xs leading-relaxed text-ink-soft/80">
      ※
      この記事の内容は情報提供を目的としたものです。気になる症状や不安があるときは、かかりつけ医・お住まいの自治体の相談窓口をご利用ください。記事内のリンクには広告を含む場合があります。
      {generatedBy && <span>この記事は管理人の方針にそって作成し、公開前に禁止表現・安全性のチェックを通しています（{generatedBy}）。</span>}
    </p>

    <section class="mt-8">
      <p class="font-heading text-sm font-bold text-ink">この記事をシェア</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <a
          href={share.x}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border-2 border-ink/5 bg-white px-4 py-1.5 text-xs font-bold text-ink-soft shadow-pop transition-transform hover:-translate-y-0.5"
        >
          𝕏 でシェア
        </a>
        <a
          href={share.line}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border-2 border-ink/5 bg-mint-soft px-4 py-1.5 text-xs font-bold text-mint-deep shadow-pop transition-transform hover:-translate-y-0.5"
        >
          LINE で送る
        </a>
        <a
          href={share.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border-2 border-ink/5 bg-sky-soft px-4 py-1.5 text-xs font-bold text-sky-deep shadow-pop transition-transform hover:-translate-y-0.5"
        >
          Facebook
        </a>
        <button
          type="button"
          data-copy-link={postUrl}
          class="rounded-full border-2 border-ink/5 bg-white px-4 py-1.5 text-xs font-bold text-ink-soft shadow-pop transition-transform hover:-translate-y-0.5"
        >
          リンクをコピー
        </button>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-5 font-heading text-xl font-bold text-ink">
            あわせて読みたい
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <ArticleCard post={r} />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12">
      <a
        href="/blog"
        class="inline-block rounded-full border-2 border-ink/10 bg-white px-5 py-2.5 text-sm font-bold text-ink shadow-pop transition-transform hover:-translate-y-0.5"
      >
        ← 記事一覧にもどる
      </a>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy-link');
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = 'コピーしました';
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      } catch {
        window.prompt('このURLをコピーしてください', url);
      }
    });
  });
</script>
