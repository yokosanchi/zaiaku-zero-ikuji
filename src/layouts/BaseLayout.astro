---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
}

const { title, description, image, ogImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImage={ogImage}
    />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <Header />
    <main class="flex-1 py-10 sm:py-14">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // きょうの訪問者カウンタ。1 ブラウザ 1 日 1 回だけ加算。
      // /api/hits（Cloudflare Pages Functions + KV）が未設定なら何も表示しない。
      (function () {
        try {
          var day = new Date().toISOString().slice(0, 10);
          var flag = 'kzi_hit_' + day;
          var seen = false;
          try {
            seen = !!localStorage.getItem(flag);
          } catch (e) {}
          fetch('/api/hits' + (seen ? '' : '?bump=1'), { method: seen ? 'GET' : 'POST' })
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (d) {
              if (!d || typeof d.today !== 'number') return;
              if (!seen) {
                try {
                  localStorage.setItem(flag, '1');
                } catch (e) {}
              }
              document.querySelectorAll('[data-hits-today]').forEach(function (el) {
                el.textContent = d.today.toLocaleString('ja-JP');
                var box = el.closest('[data-hits]');
                if (box) box.hidden = false;
              });
            })
            .catch(function () {});
        } catch (e) {}
      })();
    </script>
  </body>
</html>
