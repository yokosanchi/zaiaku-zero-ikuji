---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
}

const { title, description, image, ogImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImage={ogImage}
    />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <Header />
    <main class="flex-1 py-10 sm:py-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
